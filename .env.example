# Environment example for ScholarShield
# Copy this file to `.env` (or create a secrets manager) and fill in real values.

# ArmorIQ credentials (required for production integration)
ARMORIQ_API_KEY=your_armoriq_api_key_here
ARMORIQ_USER_ID=your_armoriq_user_id_here
ARMORIQ_AGENT_ID=your_armoriq_agent_id_here
# Optional: if you're using a proxy or different host for ArmorIQ API
ARMORIQ_BASE_URL=https://api.armoriq.example

# Gemini / Google GenAI API key (used for document parsing / reasoning)
# Either GEMINI_API_KEY or GOOGLE_API_KEY may be used depending on integration.
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative / legacy name
GOOGLE_API_KEY=

# Local mock portal base URL (when running mock_portal separately)
PORTAL_BASE_URL=http://127.0.0.1:8001

# Logging
LOG_LEVEL=INFO

# DO NOT commit your real .env file into source control. Add .env to .gitignore.# ============================================
# ARMORIQ CONFIGURATION
# ============================================

# Get this from ArmorIQ / hackathon organizers.
# NEVER commit the real value to GitHub.
ARMORIQ_API_KEY=

# Optional identifiers if required by your ArmorIQ account.
ARMORIQ_USER_ID=
ARMORIQ_AGENT_ID=


# ============================================
# LLM CONFIGURATION
# ============================================

# Add the API key for the LLM provider actually
# used by this project.
GEMINI_API_KEY=
GOOGLE_API_KEY=


# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Local backend URL
BACKEND_URL=http://127.0.0.1:8000

# Mock scholarship portal URL, if used
MOCK_PORTAL_URL=http://127.0.0.1:8001
